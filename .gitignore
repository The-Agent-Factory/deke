# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma database files
prisma/dev.db
prisma/dev.db-journal

# Claude Code temp files
tmpclaude-*-cwd
nul

# Test artifacts
test-*.ts
test-*.js
verify-*.ts

# Database files
migration.sql
*.db-journal

# Logs
dev-server.log

# Supabase local
supabase/.branches
supabase/.temp

# Content engine media (videos, renders, transcripts): local only, never in git or deploys
/media/

# Bill Biffle upload package (large media)
total-vocal-skool/bill-biffle-2026-10/*.mp4
